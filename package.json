{
  "name": "app",
  "version": "1.5.1",
  "private": true,
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev --turbopack",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build --turbopack",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start",
    "lint": "eslint",
    "test": "vitest run"
  },
  "dependencies": {
    "@base-org/account": "2.6.0",
    "@coinbase/wallet-sdk": "4.4.0",
    "@floating-ui/react": "0.27.20",
    "@reown/appkit": "2.0.0",
    "@reown/appkit-adapter-wagmi": "2.0.0",
    "@tanstack/react-query": "5.108.4",
    "@wagmi/connectors": "8.2.4",
    "@wagmi/core": "3.6.9",
    "next": "16.4.6",
    "ox": "0.14.67",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-server-dom-turbopack": "19.3.1",
    "react-server-dom-webpack": "19.3.1",
    "recharts": "3.11.1",
    "valtio": "2.3.2",
    "viem": "2.58.6",
    "wagmi": "3.7.11"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "postcss": "8.5.33",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "overrides": {
    "wagmi": "$wagmi",
    "@wagmi/connectors": "$@wagmi/connectors",
    "@wagmi/core": "3.6.9",
    "ox": "$ox",
    "valtio": "$valtio",
    "postcss": "8.5.33",
    "follow-redirects": "1.16.3",
    "source-map-js": "1.2.4",
    "zod": "4.6.7",
    "ws": "8.23.0",
    "axios": "1.21.1",
    "js-yaml": "4.3.2",
    "brace-expansion@1": "1.1.22",
    "brace-expansion@5": "5.1.0",
    "browserslist": "4.29.6",
    "sharp": "0.35.5",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.9"
    },
    "@reown/appkit-utils": {
      "@base-org/account": "$@base-org/account",
      "@coinbase/wallet-sdk": "$@coinbase/wallet-sdk"
    }
  },
  "allowScripts": {
    "@reown/appkit@2.0.0": true,
    "fsevents@2.3.3": true
  }
}
