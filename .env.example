# Muscadine App — copy to .env.local and fill in values.
# Never commit real keys.

# --- Required ---

# Alchemy API key for Base mainnet RPC (https://dashboard.alchemy.com/)
NEXT_PUBLIC_ALCHEMY_API_KEY=

# WalletConnect Cloud project ID (https://cloud.walletconnect.com/)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- Optional ---

# Public app URL (metadata, Farcaster manifest). Defaults to https://app.muscadine.io
# NEXT_PUBLIC_URL=https://app.muscadine.io
# NEXT_PUBLIC_URL=http://localhost:3000
# Legacy alias also supported: NEXT_PUBLIC_APP_URL

# Base Build account association (https://www.base.dev/) — required for verified mini app
# Domain in payload must match NEXT_PUBLIC_URL host (app.muscadine.io in production)
# NEXT_PUBLIC_ACCOUNT_ASSOCIATION_HEADER=
# NEXT_PUBLIC_ACCOUNT_ASSOCIATION_PAYLOAD=
# NEXT_PUBLIC_ACCOUNT_ASSOCIATION_SIGNATURE=

# Optional Farcaster mini app webhook (omitted from manifest when unset)
# NEXT_PUBLIC_WEBHOOK_URL=
