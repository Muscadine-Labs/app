# Copy to .env.local — never commit real keys

# Required
NEXT_PUBLIC_ALCHEMY_API_KEY=
# Same WalletConnect Cloud / Reown Dashboard project ID (https://dashboard.reown.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional — must match the browser origin for WalletConnect (defaults to http://localhost:3000 in dev)
# NEXT_PUBLIC_URL=http://localhost:3000
# NEXT_PUBLIC_URL=https://app.muscadine.xyz

# Optional gate address override (defaults to production deploy; app uses config allowlist only)
# NEXT_PUBLIC_SEND_ASSETS_GATE_ADDRESS=0xb7f2598ac79a3c6406dddb81edcc60ea72a134b9
